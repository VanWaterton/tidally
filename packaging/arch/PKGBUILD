# Maintainer: VanWaterton
pkgname=tidally-git
_pkgname=tidally
pkgver=r1
pkgrel=1
pkgdesc="Terminal client for Tidal with album art, spectrum visualizer and EQ"
arch=('x86_64' 'aarch64')
url="https://github.com/VanWaterton/tidally"
license=('MIT OR Apache-2.0')
depends=('mpv' 'gcc-libs' 'glibc')
optdepends=('libpulse: spectrum visualizer (parec)')
makedepends=('cargo' 'git' 'cmake' 'clang')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin tidally
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/tidally -t "$pkgdir/usr/bin"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
}
